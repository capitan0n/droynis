<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- All normal (install-time) permissions; none of them allows network access. -->

    <!-- Coarse screen lock strength (NONE/LOW/MEDIUM/HIGH) for ACCS-2001, API 29+. -->
    <uses-permission android:name="android.permission.REQUEST_PASSWORD_COMPLEXITY" />

    <!-- Read the default network's state (VPN, Private DNS) for the NETW checks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- See every installed app; without it Android 11+ hides most apps and APPS checks would pass falsely. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Read whether Android 16 Advanced Protection is on, for INTG-1030. -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE" />

    <!--
        Optional ADB tier. Not granted at install: only `adb shell pm grant` can give them, and
        `pm revoke` takes them back. Without them the ADB-tier checks show as N/A.
    -->

    <!-- Lets dumpsys answer us; APPS-4101 reads `dumpsys appops`. -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- dumpsys appops also asks for this permission itself; the Usage access switch is not enough. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Optional Shizuku tier. The Shizuku library adds moe.shizuku.manager.permission.API_V23, a
        permission Shizuku itself defines; Droynis can use Shizuku only after the user allows it there.
    -->

    <application>
        <!--
            Shizuku hands its binder to Droynis through this provider. Only the system, the shell
            and root hold INTERACT_ACROSS_USERS_FULL, so no other app can call it.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
