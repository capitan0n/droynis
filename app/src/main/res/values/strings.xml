    <!-- Help -->
    <string name="help_legend">Reading the results</string>
    <string name="help_score">How the score works</string>
    <string name="help_score_body">Every check that passed or failed counts, weighted by its severity. The score is the share of that weight you passed. Unknown and N/A results do not count either way.</string>
    <string name="help_score_cap">A critical failure caps the score at 40, however much else passed.</string>
    <string name="help_weights">Weights</string>
    <string name="help_grades">Grades</string>
    <string name="help_weight_value">× %1$d</string>
