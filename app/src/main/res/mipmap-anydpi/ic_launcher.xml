<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon (Android 8+): the launcher stacks the foreground on the background and cuts both
    to its own shape (circle, squircle…). Layers are 108dp; keep the art inside the central 66dp.
    The monochrome layer is the silhouette Android 13+ tints for themed icons. Master: art/droynis-icon.svg.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
