<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: allowBackup="false" stops cloud backups but not device-to-device transfers. Nothing
    of Droynis' moves to another phone either: the root tier, for one, must be turned on there by hand.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
