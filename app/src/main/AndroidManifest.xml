<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission: CI fails the build if one appears in the release APK. -->

    <!--
        Scheduled scans, off until the user picks a schedule on the Reports tab. Android 13+ asks
        only when the user turns on their notifications; nothing else notifies.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- JobScheduler keeps a schedule across reboots only for apps that hold this. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Droynis"
        tools:targetApi="31">

        <activity
            android:name=".DroynisActivity"
            android:exported="false" />

        <!--
            One launcher entry per app icon (⋮ › App icon); AppIcon.kt keeps exactly one enabled. The
            default is enabled here and the others are not, so a new install shows the default icon.
            It keeps the name the launcher activity had before icons could change, so home screen
            shortcuts from earlier versions still open the app.
        -->
        <activity-alias
            android:name=".MainActivity"
            android:exported="true"
            android:targetActivity=".DroynisActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconSombrero"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sombrero"
            android:targetActivity=".DroynisActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconGlasses"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_glasses"
            android:targetActivity=".DroynisActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconEyepatch"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_eyepatch"
            android:targetActivity=".DroynisActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconCowboy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cowboy"
            android:targetActivity=".DroynisActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconBlonde"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blonde"
            android:targetActivity=".DroynisActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Runs scheduled scans; only JobScheduler can bind it. -->
        <service
            android:name=".schedule.ScheduledScanService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

    </application>

</manifest>
