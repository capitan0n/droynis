diff --git a/checks/base/src/test/kotlin/io/github/capitan0n/droynis/checks/base/DeviceStateChecksTest.kt b/checks/base/src/test/kotlin/io/github/capitan0n/droynis/checks/base/DeviceStateChecksTest.kt
