+<!doctype html>
+<!--
+  Droynis feature graphic for F-Droid, 1024x500: fastlane/metadata/android/en-US/images/featureGraphic.png
+  The mark is the shield from droynis-icon.svg; text is set in Inter Display and Inter.
+  Render:
+    chromium --headless --hide-scrollbars --window-size=1024,500 --screenshot=featureGraphic.png art/feature-graphic.html
+-->
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>Droynis feature graphic</title>
+<style>
+  html, body { margin: 0; width: 1024px; height: 500px; overflow: hidden; }
+  body {
+    position: relative;
+    background: radial-gradient(circle at 23% 30%, #34495B 0%, #1E2B36 45%, #141C24 100%);
+    font-family: "Inter Display", Inter, sans-serif;
+  }
+  .art { position: absolute; inset: 0; }
+  .text {
+    position: absolute; left: 414px; top: 0; height: 500px;
+    display: flex; flex-direction: column; justify-content: center;
+  }
+  h1 { margin: 0; font-size: 116px; font-weight: 700; letter-spacing: -2.5px; line-height: 1; color: #EAF6F4; }
+  p { margin: 20px 0 0 4px; font-family: Inter, sans-serif; font-size: 30px; line-height: 1.32; color: #B4CACA; }
+  .chips { display: flex; gap: 9px; margin: 30px 0 0 2px; }
+  .chip {
+    display: flex; align-items: center; gap: 7px; height: 40px; padding: 0 14px 0 11px; border-radius: 20px;
+    background: rgba(155, 239, 230, 0.08); border: 1.5px solid rgba(155, 239, 230, 0.24);
+    font-family: Inter, sans-serif; font-size: 18px; font-weight: 500; color: #CFF5F0;
+  }
+  .chip svg { width: 19px; height: 19px; fill: none; stroke: #80D4D5; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+</style>
+</head>
+<body>
+<svg class="art" width="1024" height="500" viewBox="0 0 1024 500" aria-hidden="true">
+  <defs>
+    <radialGradient id="glow" gradientUnits="userSpaceOnUse" cx="236" cy="250" r="250">
+      <stop offset="0" stop-color="#3FC8BC" stop-opacity="0.30"/>
+      <stop offset="1" stop-color="#3FC8BC" stop-opacity="0"/>
+    </radialGradient>
+    <linearGradient id="teal" gradientUnits="userSpaceOnUse" x1="54" y1="28" x2="54" y2="84">
+      <stop offset="0" stop-color="#3FC8BC"/><stop offset="1" stop-color="#0B6669"/>
+    </linearGradient>
+    <clipPath id="inside">
+      <path d="M36,28 C41,31 47,35 54,35 C61,35 67,31 72,28 C74.5,34 76,41 76,48 C76,64 67,76 54,84 C41,76 32,64 32,48 C32,41 33.5,34 36,28 Z"/>
+    </clipPath>
+    <filter id="shadow" x="-30%" y="-30%" width="160%" height="160%">
+      <feDropShadow dx="0" dy="2" stdDeviation="2.4" flood-color="#000000" flood-opacity="0.35"/>
+    </filter>
+  </defs>
+
+  <!-- Scan rings around the mark -->
+  <circle cx="236" cy="250" r="250" fill="url(#glow)"/>
+  <g fill="none" stroke="#9BEFE6" stroke-width="1.5">
+    <circle cx="236" cy="250" r="188" stroke-opacity="0.11"/>
+    <circle cx="236" cy="250" r="250" stroke-opacity="0.075"/>
+    <circle cx="236" cy="250" r="312" stroke-opacity="0.05"/>
+    <circle cx="236" cy="250" r="374" stroke-opacity="0.03"/>
+  </g>
+
+  <!-- The shield from droynis-icon.svg, without its square background -->
+  <g transform="translate(236 250) scale(5.4) translate(-54 -56)" filter="url(#shadow)">
+    <path d="M36,28 C41,31 47,35 54,35 C61,35 67,31 72,28 C74.5,34 76,41 76,48 C76,64 67,76 54,84 C41,76 32,64 32,48 C32,41 33.5,34 36,28 Z" fill="url(#teal)"/>
+    <path d="M36,28 C41,31 47,35 54,35 C61,35 67,31 72,28 C74.5,34 76,41 76,48 C76,64 67,76 54,84 C41,76 32,64 32,48 C32,41 33.5,34 36,28 Z" fill="none" stroke="#9BEFE6" stroke-width="3.4" clip-path="url(#inside)"/>
+    <path d="M34,52 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z M54,52 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" fill="#CFF5F0"/>
+    <path d="M37.4,52 a6.6,6.6 0 1,0 13.2,0 a6.6,6.6 0 1,0 -13.2,0 Z M57.4,52 a6.6,6.6 0 1,0 13.2,0 a6.6,6.6 0 1,0 -13.2,0 Z" fill="#F6B940"/>
+    <path d="M40.7,52 a3.3,3.3 0 1,0 6.6,0 a3.3,3.3 0 1,0 -6.6,0 Z M60.7,52 a3.3,3.3 0 1,0 6.6,0 a3.3,3.3 0 1,0 -6.6,0 Z" fill="#132029"/>
+    <path d="M41.45,50.6 a1.15,1.15 0 1,0 2.3,0 a1.15,1.15 0 1,0 -2.3,0 Z M61.45,50.6 a1.15,1.15 0 1,0 2.3,0 a1.15,1.15 0 1,0 -2.3,0 Z" fill="#FFFFFF"/>
+    <path d="M54,58.5 L57,62.5 L54,67 L51,62.5 Z" fill="#D98E2B"/>
+    <path d="M48.5,71 L51.5,73.5 L54.5,71 M53.5,71 L56.5,73.5 L59.5,71 M51,76 L54,78.5 L57,76" fill="none" stroke="#6FD9CE" stroke-opacity="0.8" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
+  </g>
+</svg>
