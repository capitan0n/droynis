+<div class="text">
+  <h1>Droynis</h1>
+  <p>Read-only security and privacy<br>audit for your phone</p>
+  <div class="chips">
+    <span class="chip">
+      <svg viewBox="0 0 20 20"><path d="M2.6 7.6C6.8 3.9 13.2 3.9 17.4 7.6"/><path d="M5.3 10.6C8 8.4 12 8.4 14.7 10.6"/><path d="M8 13.5C9.2 12.6 10.8 12.6 12 13.5"/><path d="M3.4 3.2 16.6 16.8"/></svg>
+      No internet
+    </span>
+    <span class="chip">
+      <svg viewBox="0 0 20 20"><path d="M2 10C4.2 6.3 7 4.6 10 4.6S15.8 6.3 18 10C15.8 13.7 13 15.4 10 15.4S4.2 13.7 2 10Z"/><circle cx="10" cy="10" r="2.4"/><path d="M3.4 3.2 16.6 16.8"/></svg>
+      No analytics
+    </span>
+    <span class="chip">
+      <svg viewBox="0 0 20 20"><path d="M8.4 3.5 6.9 16.5"/><path d="M13.1 3.5 11.6 16.5"/><path d="M4.2 7.8H16.2"/><path d="M3.8 12.2H15.8"/></svg>
+      Root not required
+    </span>
+  </div>
+</div>
